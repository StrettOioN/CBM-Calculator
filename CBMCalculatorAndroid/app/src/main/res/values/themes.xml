<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CBMCalculatorAndroid" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:button">@style/CalcButton</item>
        <item name="buttonStyle">@style/CalcButton</item>
        <item name="android:buttonStyle">@style/CalcButton</item>
    </style>

    <style name="Theme.CBMCalculatorAndroid" parent="Base.Theme.CBMCalculatorAndroid" />

    <style name="CalcButton" parent="MaterialAlertDialog.Material3">
        <item name="android:background">#F888</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.CBMCalculatorAndroid.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.CBMCalculatorAndroid.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.CBMCalculatorAndroid.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>