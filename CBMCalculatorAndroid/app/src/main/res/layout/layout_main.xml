<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Display for input and result -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="32sp"
        android:textColor="@color/white"
        android:gravity="end"
        android:padding="16dp"
        android:background="#FF303030"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        >

    </LinearLayout>
    <EditText
        android:id="@+id/Expression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="32sp"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:background="#FEEE"/>

    <!-- Number and operation buttons -->
    <LinearLayout
        android:id="@+id/btngrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Final row: C 0 = ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button  android:onClick="onClear" android:id="@+id/btnc" android:text="C" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btnh" android:text="H" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btntools" android:text="Tool" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btnDivide" android:text="÷" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
        </LinearLayout>

        <!-- Top row: 7 8 9 + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:orientation="horizontal">

            <Button  android:onClick="onBtnClick" android:id="@+id/btn7" android:text="7" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btn8" android:text="8" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btn9" android:text="9" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btnMultiply" android:text="×" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
        </LinearLayout>

        <!-- Middle row: 4 5 6 - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:orientation="horizontal">

            <Button android:onClick="onBtnClick" android:id="@+id/btn4" android:text="4" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button android:onClick="onBtnClick" android:id="@+id/btn5" android:text="5" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button android:onClick="onBtnClick" android:id="@+id/btn6" android:text="6" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btnMinus" android:text="-" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
        </LinearLayout>

        <!-- Bottom row: 1 2 3 × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:orientation="horizontal">

            <Button  android:onClick="onBtnClick" android:id="@+id/btn1" android:text="1" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btn2" android:text="2" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btn3" android:text="3" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btnPlus" android:text="+" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
        </LinearLayout>

        <!-- Final row: C 0 = ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:orientation="horizontal">

            <Button  android:onClick="onBtnClick" android:id="@+id/btndot" android:text="." android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onBtnClick" android:id="@+id/btn0" android:text="0" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <ImageButton android:id="@+id/btnbackspace" android:src="@drawable/backspace" android:scaleType="fitCenter" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
            <Button  android:onClick="onEqual" android:id="@+id/btnequal" android:text="=" android:layout_weight="1" android:layout_width="0dp" android:layout_height="@dimen/button_height" style="@style/CalcButton" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
