<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:orientation="vertical"
    tools:context=".MainActivity"
    >
    <ui.cbmtext.CBMText
        android:id="@+id/ctAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:pad_it="true"
        app:editable="false"
        app:strokeColor="@color/colorAccent"
        app:strokeWidth="4dp"
        app:radius="16dp"
        app:hint="0"
        app:textSize="28sp"
        app:gravity="end"
        />
    <ui.shapelayout.ShapeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="20dp"
        android:padding="4dp"
        app:hl_gravity="center_vertical"
        app:hl_mode="linear"
        app:hl_orientation="horizontal"
        app:fillColor="#AAA"
        app:cornerRadius="8dp"
        app:hl_itemSpacing="@dimen/dim4dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <ui.shapelayout.FlowLayout
                android:id="@+id/slExpression"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
<!--        <ui.cbmtext.CBMButton-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="match_parent"-->
<!--            android:layout_margin="2dp"-->
<!--            android:textColor="#FFF"-->
<!--            app:fillColor="@color/black"-->
<!--            app:radius="@dimen/dim16dp"-->
<!--            app:selected_color="#333"-->
<!--            android:text="7" />-->
        </ScrollView>
    </ui.shapelayout.ShapeLayout>
    <ui.shapelayout.ShapeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:hl_mode="linear"
        app:hl_orientation="vertical"
        android:visibility="gone"
        />
    <ui.cbmtext.CBMText
        android:id="@+id/stExpressCurrNr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        app:gravity="end"
        app:pad_it="true"
        app:hint="0"
        app:textSize="20sp"
        app:strokeColor="@color/black"
        app:strokeWidth="4dp"
        app:textColor="#000"
        app:radius="@dimen/dim8dp"
        />

    <ui.shapelayout.ShapeLayout
        android:id="@+id/slPad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dim4dp"
        android:layout_margin="4dp"
        app:hl_fillColor="#888"
        app:hl_mode="grid"
        app:hl_spanCount="4"
        app:hl_itemSpacing="@dimen/dim4dp">

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            app:radius="@dimen/dim16dp"
            app:text="C" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            app:radius="@dimen/dim16dp"
            android:textSize="10sp"
            app:text="Tools" />

        <ui.cbmtext.CBMButton
            android:id="@+id/btnBODMAS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:strokeWidth="4dp"
            app:pressed_color="@color/colorAccentA"
            app:selected_color="@color/colorAccent"
            app:radius="@dimen/dim16dp"
            app:editable="false"
            app:gravity="center"
            app:text="÷×+-"
            android:textSize="10sp"/>

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="÷"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:radius="@dimen/dim16dp"
            app:selected_color="#333"
            app:textColor="@color/white"
            app:text="7" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            app:radius="@dimen/dim16dp"
            app:text="8" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="9"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="×"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:radius="@dimen/dim16dp"
            app:selected_color="#333"
            app:text="4" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            app:radius="@dimen/dim16dp"
            app:text="5" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="6"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="-"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="1"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            app:radius="@dimen/dim16dp"
            app:text="2" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:radius="@dimen/dim16dp"
            app:selected_color="#333"
            app:text="3" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="+"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:radius="@dimen/dim16dp"
            app:selected_color="#333"
            app:text="." />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:textColor="#FFF"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            app:radius="@dimen/dim16dp"
            app:text="0" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="-+"
            app:fillColor="@color/black"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />

        <ui.cbmtext.CBMButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:text="="
            app:fillColor="@color/colorAccent"
            app:pressed_color="@color/colorAccentA"
            android:textColor="#FFF"
            app:radius ="@dimen/dim16dp" />
    </ui.shapelayout.ShapeLayout>

    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:layout_margin="2dp"
        android:background="@drawable/bg_black_blue_r"
        >
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:padding="5dp"
            android:background="@drawable/bg_black_blue_sr"
            android:scaleType="fitCenter"
            android:src="@drawable/svg_clear"
            android:visibility="gone"
            />
        <ImageButton
            android:id="@+id/btnScifra"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:padding="5dp"
            android:background="@drawable/bg_black_blue_sr"
            android:scaleType="fitCenter"
            android:src="@drawable/svg_options"
            />
        <ImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:padding="5dp"
            android:src="@drawable/svg_backspace"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_black_blue_sr"
            />
    </LinearLayout>
</LinearLayout>